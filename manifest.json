{
  "manifest_version": 3,
  "name": "OnLuyen Auto Solver Ultra v8.0 (Deep Reasoning AI)",
  "version": "8.0.0",
  "description": "Phiên bản siêu nâng cấp trí tuệ: đọc chuẩn KaTeX/MathJax/gạch chân/bảng/đọc hiểu, tư duy sâu HIGH & tự phản biện 2 lớp.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://app.onluyen.vn/*",
    "https://*.onluyen.vn/*",
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Auto Solver Ultra v8.0",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.onluyen.vn/*",
        "https://*.onluyen.vn/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.onluyen.vn/*",
        "https://*.onluyen.vn/*"
      ],
      "js": [
        "dom_extractor.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
